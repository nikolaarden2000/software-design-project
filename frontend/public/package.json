{
  "name": "project-root",
  "version": "1.0.0",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "jest --coverage",
    "e2e": "playwright test e2e/booking.playwright.spec.js",
    "e2e:ci": "playwright test e2e/booking.playwright.spec.js --workers=1 --reporter=list,html",
    "e2e:headed": "playwright test e2e/booking.playwright.spec.js --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test e2e/booking.playwright.spec.js --debug"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "auth/*.js",
      "home/*.js",
      "me/*.js",
      "room/*.js",
      "admin/*.js",
      "superuser/*.js",
      "/*.js",
      "!**/node_modules/**",
      "!**/*.test.js",
      "!**/e2e/**"
    ]
  },
  "dependencies": {
    "selenium-webdriver": "^4.41.0"
  }
}